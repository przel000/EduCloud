# Copy this file to .env and set your own values before starting the stack.
# Never commit the real .env file.

# MariaDB
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=change_me_db_password

# Nextcloud admin (used on first install only)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_admin_password

# MinIO root credentials
MINIO_ROOT_USER=educloudminio
MINIO_ROOT_PASSWORD=change_me_minio_password

# Published ports (host)
NGINX_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
CADVISOR_PORT=8081

# Recovery script
HEALTHCHECK_URL=http://localhost:8080/status.php
HEALTHCHECK_INTERVAL_SECONDS=20
DOCKER_NETWORK=educloud_default
